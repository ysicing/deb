name: ys-nezha-agent
version: {{ .Version }}
arch: {{ .Arch }}
platform: linux
section: net
priority: optional
maintainer: ysicing
description: "Nezha monitoring agent from the gaeaflow/nezha fork."
license: Apache-2.0
homepage: https://cnb.cool/gaeaflow/nezha
depends:
  - ca-certificates
conflicts:
  - nezha-agent

contents:
  - src: ./nezha-agent
    dst: /usr/local/bin/nezha-agent
    file_info:
      mode: 0755
      owner: root
      group: root
  - src: ./nezha-agent.service.example
    dst: /usr/share/ys-nezha-agent/nezha-agent.service.example
    file_info:
      mode: 0644
  - src: ./agent.env.example
    dst: /usr/share/ys-nezha-agent/agent.env.example
    file_info:
      mode: 0644
  - src: ./LICENSE
    dst: /usr/share/doc/ys-nezha-agent/LICENSE
    file_info:
      mode: 0644
